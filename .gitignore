# Large or regenerable artifacts — fetch or rebuild, do not commit (ADR-0003)
data/
runs/*/vectors/
runs/*/chunks.jsonl
runs/*/corpus_snapshot.json
*.gguf
*.safetensors
*.bin

# Secrets
.env

# Local scratch from tooling and one-off measurement
.scratch/corpus-measure/
.scratch/**/clones/

# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Chainlit runtime artifacts (regenerated on every import)
.files/
.chainlit/translations/
chainlit.md

# Demo capture output (regenerate with .scratch/capture_demo.py)
.scratch/demo-capture.json
.scratch/capture.log
.scratch/serve-*.out
.scratch/serve-*.err

# Credentials and endpoints. Copy to `.env` and fill in. Never commit `.env`.
#
# Every config file leaves `llm.base_url` empty on purpose (AGENTS.md: no endpoints
# or credentials in files), so this variable is the only place the gateway is named.
# The value below is a placeholder -- put the real one in `.env`, which is ignored
# by git. The OpenCode Go subscription needs the /zen/go/v1 path, not /zen/v1.
LLM_BASE_URL=https://gateway.example/v1
LLM_API_KEY=
# Requests are routed to a catalog by this header; the gateway answers 402 without it.
LLM_SESSION_HEADER=x-opencode-session

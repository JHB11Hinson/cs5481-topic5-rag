{"chunk_id": "c-e725a083287aba64", "claim_id": "A027-c1", "containment_ok": true, "detail": "", "doc_id": "docs/commands/operator/init", "error_class": "", "item_id": "A027", "judge_reason": "", "judge_supported": null, "nli_score": null, "nli_supported": null, "quote": "During initialization, Vault generates a root key, which is stored in the storage backend alongside all other Vault data. The root key itself is encrypted and requires an _unseal key_ to decrypt it.", "span_end": 553, "span_start": 355, "supported": true}

{"chunk_id": "c-2e02db0a352ce89c", "claim_id": "A027-c3", "containment_ok": true, "detail": "", "doc_id": "docs/concepts/seal", "error_class": "", "item_id": "A027", "judge_reason": "", "judge_supported": null, "nli_score": null, "nli_supported": null, "quote": "Vault requires a certain threshold of shares to reconstruct the unseal key. Vault operators add shares one at a time in any order until Vault has enough shares to reconstruct the key. Then, Vault uses the unseal key to decrypt the root key. This is the Vault unseal process.", "span_end": 1693, "span_start": 1419, "supported": true}

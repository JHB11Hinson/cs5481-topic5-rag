{"chunk_id": "c-02c33690c4b1e96a", "claim_id": "A027-c2", "containment_ok": true, "detail": "", "doc_id": "docs/concepts/seal", "error_class": "", "item_id": "A027", "judge_reason": "", "judge_supported": null, "nli_score": null, "nli_supported": null, "quote": "When you start a Vault server, it starts in a sealed state. In this state, Vault can access the physical storage, but it cannot decrypt any of the data on it.", "span_end": 158, "span_start": 0, "supported": true}

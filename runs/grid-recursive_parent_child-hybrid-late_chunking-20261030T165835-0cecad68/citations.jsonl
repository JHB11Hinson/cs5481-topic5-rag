{"chunk_id": "c-3becd3bb1a1aaa30", "claim_id": "A027-c1", "containment_ok": false, "detail": "quoted text does not occur in the cited chunk", "doc_id": "docs/commands/operator/init", "error_class": "quote_not_in_chunk", "item_id": "A027", "judge_reason": "", "judge_supported": null, "nli_score": null, "nli_supported": null, "quote": "The default Vault configuration uses Shamir's Secret Sharing to split the root key into a configured number of shards (referred as key shares, or unseal keys). A certain threshold of shards is required to reconstruct the root key, which is then used to decrypt the Vault's encryption key.", "span_end": -1, "span_start": -1, "supported": false}

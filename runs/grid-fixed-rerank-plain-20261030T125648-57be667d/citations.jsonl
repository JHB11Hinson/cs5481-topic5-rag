{"chunk_id": "c-b8df6f785eff03af", "claim_id": "A029-c1", "containment_ok": true, "detail": "", "doc_id": "docs/concepts/tokens", "error_class": "", "item_id": "A029", "judge_reason": "", "judge_supported": null, "nli_score": null, "nli_supported": null, "quote": "Root tokens are tokens that have the `root` policy attached to them. Root tokens can do anything in Vault. _Anything_.", "span_end": 225, "span_start": 107, "supported": true}
{"chunk_id": "c-ab1c298ddbfa72d9", "claim_id": "A029-c2", "containment_ok": true, "detail": "", "doc_id": "docs/concepts/policies", "error_class": "", "item_id": "A029", "judge_reason": "", "judge_supported": null, "nli_score": null, "nli_supported": null, "quote": "The `root` policy is a built-in Vault policy that cannot be modified or removed. Any user associated with this policy becomes a root user. A root user can do _anything_ within Vault.", "span_end": 2955, "span_start": 2773, "supported": true}
{"chunk_id": "c-2a442c99d1fa0734", "claim_id": "A030-c1", "containment_ok": true, "detail": "", "doc_id": "docs/commands/secrets/move", "error_class": "", "item_id": "A030", "judge_reason": "", "judge_supported": null, "nli_score": null, "nli_supported": null, "quote": "The `secrets move` command moves an existing secrets engine to a new path. Any leases from the old secrets engine are revoked, but all configuration associated with the engine is preserved.", "span_end": 205, "span_start": 16, "supported": true}

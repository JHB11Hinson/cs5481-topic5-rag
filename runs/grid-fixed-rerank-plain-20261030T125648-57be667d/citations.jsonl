{"chunk_id": "c-b8e551e3b6c1225c", "claim_id": "A032-c1", "containment_ok": true, "detail": "", "doc_id": "docs/internals/recommended-patterns", "error_class": "", "item_id": "A032", "judge_reason": "", "judge_supported": null, "nli_score": null, "nli_supported": null, "quote": "Since each token adds to the client count, and each unique authentication issues a token, you should use identity entities to create aliases that connect each login to a single identity.", "span_end": 2624, "span_start": 2438, "supported": true}
{"chunk_id": "c-b8e551e3b6c1225c", "claim_id": "A032-c2", "containment_ok": true, "detail": "", "doc_id": "docs/internals/recommended-patterns", "error_class": "", "item_id": "A032", "judge_reason": "", "judge_supported": null, "nli_score": null, "nli_supported": null, "quote": "When you do not use identity entities, each new client is counted as a separate identity when using another auth method not linked to the user's entity.", "span_end": 3071, "span_start": 2919, "supported": true}

{
  "baseline": {
    "closed_book": false,
    "long_context": false,
    "long_context_max_chars": 12000
  },
  "chunk": {
    "overlap": 8,
    "parent_size": 64,
    "size": 32,
    "strategy": "fixed"
  },
  "context": {
    "mode": "plain",
    "prefix_cache_path": "data/cache/prefixes.sqlite",
    "prefix_concurrency": 4,
    "prefix_max_tokens": 120,
    "prefix_model": "",
    "prefix_neighbours": 1,
    "prefix_prompt_version": "v1",
    "window_overlap": 256,
    "window_tokens": 2048
  },
  "corpus": {
    "snapshot_id": "fixture-smoke-v1",
    "source": "fixtures/smoke/docs.jsonl"
  },
  "embed": {
    "batch_size": 16,
    "cache_path": "data/cache/embeddings.sqlite",
    "device": "auto",
    "dim": 256,
    "late_max_seq_length": 8192,
    "max_seq_length": 8192,
    "model_id": "stub-hashing",
    "provider": "stub"
  },
  "generate": {
    "abstain_score_threshold": 0.15,
    "max_claims": 2,
    "min_claim_overlap": 0.12,
    "model_id": "stub-generator",
    "provider": "stub"
  },
  "golden": {
    "items_path": "fixtures/smoke/golden.jsonl",
    "limit": 5
  },
  "index": {
    "backend": "memory",
    "path": "data/index"
  },
  "judge": {
    "enabled": true,
    "llm_max_chars": 2000,
    "llm_model": "deepseek-v4-pro",
    "nli_model": "MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli",
    "nli_threshold": 0.5
  },
  "llm": {
    "base_url": "https://opencode.ai/zen/go/v1",
    "cache_path": "data/cache/llm.sqlite",
    "context_chunks": 8,
    "max_tokens": 1600,
    "model_generate": "deepseek-v4.1-flash",
    "model_judge": "deepseek-v4-pro",
    "price_in_usd_per_mtok": 0.15,
    "price_judge_in_usd_per_mtok": 0.0,
    "price_judge_out_usd_per_mtok": 0.0,
    "price_out_usd_per_mtok": 0.6,
    "session_header": "x-opencode-session",
    "session_id": "",
    "temperature": 0.0,
    "timeout": 180
  },
  "retrieval": {
    "hop_rewrite_model": "",
    "hops": 1,
    "k": 3,
    "mode": "dense",
    "rerank_max_length": 512,
    "rerank_top": 12,
    "reranker": "BAAI/bge-reranker-v2-m3",
    "rrf_k": 60,
    "trigger_threshold": null
  },
  "run": {
    "name": "judge-smoke",
    "out_root": "runs"
  }
}

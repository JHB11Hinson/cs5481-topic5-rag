{"chunk_id": "c-8d95e6b1d247a09d", "claim_id": "A027-c1", "containment_ok": true, "detail": "", "doc_id": "docs/commands/operator/unseal", "error_class": "", "item_id": "A027", "judge_reason": "", "judge_supported": null, "nli_score": null, "nli_supported": null, "quote": "The `operator unseal` allows the user to provide a portion of the root key to unseal a Vault server. Vault starts in a sealed state. It cannot perform operations until it is unsealed.", "span_end": 183, "span_start": 0, "supported": true}

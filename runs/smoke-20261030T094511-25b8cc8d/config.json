{
  "chunk": {
    "overlap": 8,
    "parent_size": 64,
    "size": 32,
    "strategy": "fixed"
  },
  "context": {
    "mode": "plain"
  },
  "corpus": {
    "snapshot_id": "fixture-smoke-v1",
    "source": "fixtures/smoke/docs.jsonl"
  },
  "embed": {
    "batch_size": 16,
    "cache_path": "data/cache/embeddings.sqlite",
    "device": "auto",
    "dim": 256,
    "max_seq_length": 8192,
    "model_id": "stub-hashing",
    "provider": "stub"
  },
  "generate": {
    "abstain_score_threshold": 0.15,
    "max_claims": 2,
    "min_claim_overlap": 0.12,
    "model_id": "stub-generator",
    "provider": "stub"
  },
  "golden": {
    "items_path": "fixtures/smoke/golden.jsonl",
    "limit": 5
  },
  "index": {
    "backend": "memory",
    "path": "data/index"
  },
  "retrieval": {
    "k": 3,
    "mode": "dense",
    "rerank_top": 8,
    "reranker": "BAAI/bge-reranker-v2-m3",
    "rrf_k": 60
  },
  "run": {
    "name": "smoke",
    "out_root": "runs"
  }
}
